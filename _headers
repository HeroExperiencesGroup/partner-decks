/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache

/natgeo/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

/shared/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/shared/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/shared/js/*
  Cache-Control: public, max-age=3600, must-revalidate
